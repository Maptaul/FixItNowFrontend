# Base URL of the FixItNow REST API.
# Live: https://fixitbackend.vercel.app   Local: http://localhost:5000
NEXT_PUBLIC_API_URL="https://fixitbackend.vercel.app"

# Same value as the backend's JWT_ACCESS_SECRET.
# Optional: when set, proxy.ts verifies the session cookie's signature
# instead of merely decoding it. The API always re-verifies regardless.
JWT_ACCESS_SECRET=""
